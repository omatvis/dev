@page
@using Packt.Shared
@model Northwind.Web.Pages.CustomerDetailsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<main>
    <style>
        .main {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            height: 800px
        }

        .item {
            border: 2px solid #bbd3db;
            margin: 10px 5px 5px 5px;
            border-radius: 5px;
        }

        .header {
            position: relative;
            top: -10px;
            margin-left: 10px;
            background-color: #bbd3db;
            border-radius: 5px;
            padding: 2px 5px 2px 5px;
        }

        .user-form {
            display: grid;
            gap: 0.5rem;
            grid-template-columns: 200px auto;
        }

        .user-form>dt,
        .user-form>dd {
            margin: 0;
        }

        .user-form>dt {
            text-align: right;
            font-weight: bold;
        }
    </style>
    <div class="main">
        <div class="item" style="flex: 1 1 auto;align-items: flex-start;height: 250px;">
            <label class="header">Customer: Alfreds Futterkiste</label>
            <dl class="user-form">
                <dt>Contact Title:</dt>
                <dd>@Model.SelectedCustomer?.ContactTitle</dd>
                <dt>Contact Name:</dt>
                <dd>@Model.SelectedCustomer?.ContactName</dd>
                <dt>Phone:</dt>
                <dd>@Model.SelectedCustomer?.Phone</dd>
                <dt>Fax:</dt>
                <dd>@Model.SelectedCustomer?.Fax</dd>
                <dt>Country:</dt>
                <dd>@Model.SelectedCustomer?.Country</dd>
                <dt>City:</dt>
                <dd>@Model.SelectedCustomer?.City</dd>
                <dt>Address:</dt>
                <dd>@Model.SelectedCustomer?.Address</dd>
            </dl>
        </div>
        <div class="item" style="flex: 8 1 auto; align-self: stretch">
            <label class="header">Order</label>
            <table class="table">
                <thead class="thead-inverse">
                    <tr>
                        <th>Order ID</th>
                        <th>Order Date</th>
                        <th>Shipped Date</th>
                        <th>Freight</th>
                        <th>Ship Name</th>
                        <th>Ship Address</th>
                    </tr>
                </thead>
                <tbody>

                    @if (Model.CustomerOrders is not null)
                        @foreach (var order in Model.CustomerOrders)
                        {
                            <tr>
                                <td>@order.OrderId</td>
                                <td>@order.OrderDate</td>
                                <td>@order.ShippedDate</td>
                                <td>@order.Freight</td>
                                <td>@order.ShipName</td>
                                <td>@order.ShipAddress</td>
                            </tr>
                        }
                </tbody>
            </table>
        </div>
    </div>
</main>