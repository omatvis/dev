<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>a5f4400b-dbf9-4000-9be7-7a8a36adde4c</UserSecretsId>
  </PropertyGroup>

	<ItemGroup Label="To simplify use of WriteLine.">
		<Using Include="System.Console" Static="true" />
	</ItemGroup>
	
	<ItemGroup Label="Package versions set in ModernWeb\Directory.Packages.props.">
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Northwind.EntityModels.SqlServer\Northwind.EntityModels.SqlServer.csproj" />
	</ItemGroup>
	
</Project>
